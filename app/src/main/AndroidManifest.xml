<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- For Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- For Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 想好再买：检测支付应用进入前台（使用情况访问，需用户在系统设置授权） -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 想好再买：前台守护服务（specialUse 类型，Android 14+ 要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 银行交易短信抓取 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- 支付地点抓取（粗略/精确定位） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 支付发生在后台（通知监听/短信接收），抓取当时位置必须允许后台定位 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 公共目录备份：Android 9 及以下写公共 Download 需要 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <package android:name="com.google.android.apps.docs" />
    </queries>

    <application
        android:name=".SmartLedgerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLedger" >

        <activity
            android:name=".activity.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activity.OnboardingActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.AddEditTransactionActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activity.CaptureInboxActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.StatsActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.CategoryDetailActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.WishlistActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.WishlistAddActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activity.SettingsActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.AiConfigActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.SmartLedger" />

        <activity android:name=".activity.ExpenseActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.AddEditExpenseActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.ViewExpenseActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />

        <activity android:name=".activity.ElectricityActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.AddEditElectricityActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.ViewElectricityActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />

        <activity android:name=".activity.MilkActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.ViewMilkActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".activity.CreateCustomLedgerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".activity.GenericLedgerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".activity.GenericAddEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".activity.GenericViewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".activity.CustomDailyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".activity.AnalyticsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name=".activity.AiInsightActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity android:name=".activity.CalculatorActivity" android:exported="false" android:label="Calculator" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />
        <activity android:name=".activity.TrashBinActivity" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />

        <activity
            android:name=".activity.ImageViewerActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:hardwareAccelerated="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".util.MilkNotificationReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="ACTION_MILK_REPLY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".util.MilkBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 自动抓取：支付 App 通知监听 -->
        <service
            android:name=".capture.LedgerNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 自动抓取：银行交易短信 -->
        <receiver
            android:name=".capture.BankSmsReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 想好再买：支付应用前台守护（进入支付 App 时弹出冷静提醒） -->
        <service
            android:name=".util.PurchaseGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitor payment-app foreground transitions to show a think-before-buy spending reminder" />
        </service>

        <!-- 想好再买：愿望清单 24 小时回访通知上的快捷操作 -->
        <receiver
            android:name=".util.WishlistActionReceiver"
            android:exported="false" />

    </application>
</manifest>

<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SmartLedger" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_main</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorOutline">@color/divider</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:windowBackground">@color/surface_dim</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_dim</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeStyle">@style/CustomActionMode</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="android:actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="android:windowAnimationStyle">@style/SmoothActivityAnimation</item>
    </style>

    <style name="SmoothActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="CustomActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/teal_dark</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="android:actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="titleTextStyle">@style/ActionModeTitle</item>
    </style>

    <style name="ActionModeTitle" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Theme.App.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_card</item>
    </style>

    <style name="App.MaterialDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="materialCalendarHeaderLayout">@style/App.MaterialDatePicker.Header</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/teal_main</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/teal_main</item>
    </style>

    <style name="App.MaterialDatePicker.Header" parent="Widget.Material3.MaterialCalendar.HeaderLayout">
        <item name="android:background">@color/teal_main</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
    </style>

    <style name="Theme.SmartLedger" parent="Base.Theme.SmartLedger" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_animated_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartLedger</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
    </style>

    <style name="DetailHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/teal_main</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Typography hierarchy -->
    <style name="TextAppearance.App.Balance" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/teal_main</item>
    </style>

    <style name="TextAppearance.App.ItemTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.ItemSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Amount" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Refined toolbar — surface background instead of primary color -->
    <style name="Widget.App.Toolbar.Surface" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface_dim</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleLarge</item>
    </style>
</resources>

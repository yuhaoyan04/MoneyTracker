<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#12291F" android:paddingTop="32dp" android:paddingBottom="32dp">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/guard_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="知余   想好再买" android:textSize="14sp" android:textColor="#C2DEC6"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="给决定\n留一点空间" android:textSize="30sp" android:textStyle="bold" android:textColor="#F1F5EB" android:lineSpacingExtra="3dp"/>
                <TextView android:id="@+id/tvCooldownSpend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="本次消费" android:textSize="14sp" android:textColor="#CAD8CD" android:lineSpacingExtra="5dp"/>
                <TextView android:id="@+id/tvCountdown" android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:gravity="center" android:background="@drawable/guard_countdown" android:text="5" android:textSize="48sp" android:textColor="#E8DBAE" android:textStyle="bold" android:importantForAccessibility="no"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="这笔消费，符合你现在的需要吗？\n片刻之后，再选择下一步。" android:textSize="14sp" android:textColor="#CAD8CD" android:lineSpacingExtra="5dp"/>
                <Button android:id="@+id/btnContinue" style="@android:style/Widget.Material.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="28dp" android:padding="12dp" android:background="@drawable/guard_primary" android:backgroundTint="@null" android:enabled="false" android:text="冷静片刻…" android:textAllCaps="false" android:singleLine="false" android:maxLines="3" android:textColor="#173D2C" android:textSize="15sp" android:textStyle="bold"/>
                <Button android:id="@+id/btnWishlist" style="@android:style/Widget.Material.Button.Borderless" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:text="先记入愿望清单" android:textColor="#E1EADF" android:textSize="14sp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="每一笔，都由你决定。" android:textSize="12sp" android:textColor="#B0C4B4"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
